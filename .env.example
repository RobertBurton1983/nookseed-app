# Copy this file to .env for local testing, and add the same values
# in Vercel: Project -> Settings -> Environment Variables.

# Stripe Dashboard -> Developers -> API keys -> Secret key
# Use the "test mode" key (starts sk_test_...) until you're ready to go live.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret
# Only needed once you set up the optional /api/webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Your deployed site URL, no trailing slash.
# Local testing: http://localhost:3000
# Production:    https://your-project.vercel.app  (or your custom domain)
DOMAIN=https://your-project.vercel.app

# Google Cloud Console -> APIs & Services -> Credentials -> API key
# Make sure "Places API (New)" is enabled for the project this key belongs to.
GOOGLE_PLACES_API_KEY=your_google_places_api_key
